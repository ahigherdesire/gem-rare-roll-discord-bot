# Supabase project (the PUBLIC anon key only — never the service-role key).
# These are the same public values the game client uses.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Discord channel webhook: Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# Optional: only post rolls at or above these odds (1 in N). 0 posts every
# roll the game already deems rare. Example: 100000000 = only 1-in-100M+.
MIN_EFFECTIVE_RARITY=0

# Optional: how often to check for new rolls, in seconds (min 5).
POLL_SECONDS=20

# Optional: where to persist the "last posted roll" cursor across restarts.
STATE_FILE=./.rare-roll-cursor.json
